# ============================================================
# Java project - Git ignore rules
# ============================================================
#
# Purpose:
# Keep generated files, local IDE settings, and temporary files
# out of version control.
#
# Note:
# .gitignore does not untrack files already committed to Git.
# ============================================================


# ------------------------------------------------------------
# 1. Java build output
# ------------------------------------------------------------

# Compiled class file
*.class
out/
build/
target/


# ------------------------------------------------------------
# 2. Build-tool state and caches
# ------------------------------------------------------------

.gradle/


# ------------------------------------------------------------
# 3. IDE and editor settings
# ------------------------------------------------------------

# IntelliJ IDEA
.idea/
*.iml

# Eclipse
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
bin/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Visual Studio Code
.vscode/

# Kotlin tooling
.kotlin/


# ------------------------------------------------------------
# 4. Logs and JVM crash reports
# ------------------------------------------------------------

# Log file
*.log

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# BlueJ files
*.ctxt

# ------------------------------------------------------------
# 5. Generated packages and archives
# ------------------------------------------------------------
# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar



# ------------------------------------------------------------
# 6. Operating-system files
# ------------------------------------------------------------

.DS_Store
Thumbs.db


# ------------------------------------------------------------
# 7. Project-specific exclusions
# ------------------------------------------------------------
#
# Keep these only if they are intentionally private, temporary,
# or generated in this repository. Remove any rule for a file
# that should be version-controlled.
#

# Lessons folder: uncomment only if lessons should stay local
lessons/

# Personal scratch notes
pseudocode.md
pseudocode.txt

# C practice file kept in this Java project
*.c

# Nested IntelliJ module file
src/src.iml

# Local tests: ignore only if these are private/untracked tests.
# If tests are part of the assignment or project, do NOT ignore them.
tests/
